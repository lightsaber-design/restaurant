{
  "expo": {
    "name": "Antojo",
    "slug": "antojo",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "savvyfoodie",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      },
      "package": "com.caroldenissetorres.savvyfoodie"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SavvyFoodie necesita tu ubicación para mostrarte restaurantes cercanos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16A34A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5b6b3c36-2563-4a32-a03f-f7411f327aca"
      }
    }
  }
}
