GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# URL del servidor de la API para la app móvil.
# Emulador Android: usa 10.0.2.2 (apunta a localhost del PC) → ya configurado por defecto.
# Dispositivo físico: pon la IP LAN de tu PC (ej. 192.168.1.42).
#   Encuéntrala con: ipconfig (Windows) → "Dirección IPv4" de tu WiFi.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4173
